# Copy this file to .env and fill in your own values. Never share .env.

PORT=3000
# The address people open in the browser (used for the Google sign-in redirect).
APP_URL=http://localhost:3000
# Long random text used to sign login cookies. Change it.
SESSION_SECRET=change-me-to-a-long-random-string
TZ=Asia/Manila

# MySQL / MariaDB (XAMPP defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=attendance_db

# Google sign-in. In Google Cloud Console add this Authorized redirect URI:
#   http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Comma-separated emails that get the admin role when they sign in.
ADMIN_EMAILS=

# Gmail SMTP (use a Gmail App Password, not your account password)
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_NAME=FBC Attendance System
# Set to false to turn off parent emails (e.g. while testing).
MAIL_ENABLED=true

# Face check-in
# Max face distance for a match. Lower = stricter.
FACE_MATCH_THRESHOLD=0.45
# The best match must beat the next-best student by at least this much.
FACE_MATCH_MARGIN=0.05
# Minutes after the first class starts before a check-in counts as Late.
LATE_GRACE_MINUTES=15
# Start time used when a section has no schedule for that day.
DEFAULT_START_TIME=07:30
# Mark students Absent automatically when they haven't checked in.
# Time of day (24h) to run it on school days; leave empty to turn it off.
AUTO_ABSENT_TIME=09:00
# Only auto-mark students who registered their face (others stay manual).
AUTO_ABSENT_ONLY_FACE_ENROLLED=true
# Students must blink at the kiosk (stops someone holding up a printed photo).
# Only turn off if your camera is too low quality to see blinks.
KIOSK_REQUIRE_BLINK=true
# Seconds after a student is scanned (face or QR card) before the same student can be scanned again.
SCAN_COOLDOWN_SECONDS=20
