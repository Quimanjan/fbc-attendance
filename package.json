{
  "name": "fbc-attendance",
  "version": "2.0.0",
  "private": true,
  "description": "FBC Attendance System with face registration and kiosk check-in (TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p server/tsconfig.json",
    "start": "node dist/server/index.js",
    "auto-absent": "node dist/server/jobs/autoAbsent.js",
    "migrate": "node dist/server/migrate.js",
    "import-db": "node dist/server/importDb.js",
    "export-db": "node dist/server/exportDb.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "seed:classroom": "node dist/server/jobs/seedClassroom.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.3.0",
    "mysql2": "^3.24.6",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.25",
    "@types/express-mysql-session": "^3.0.8",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vladmandic/face-api": "^1.7.15",
    "concurrently": "^10.0.6",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.180.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
